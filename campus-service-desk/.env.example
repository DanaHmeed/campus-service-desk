# Campus Service Desk — Environment Variables
# Copy this file to .env and adjust values for your environment.
# NEVER commit the actual .env file to source control.

# Database
DB_ROOT_PASSWORD=rootpassword
DB_URL=jdbc:mysql://localhost:3306/campus_service_desk
DB_USERNAME=root
DB_PASSWORD=rootpassword

# JWT (must be at least 32 characters / 256 bits)
JWT_SECRET=change-me-to-a-strong-random-secret-of-at-least-256-bits
JWT_EXPIRATION_MS=86400000

# Server
SERVER_PORT=8080
